# Still Loading... Web Configuration
# Copy this file to .env.local for local overrides
# DO NOT COMMIT PRIVATE BEARER TOKENS HERE

# Public URL of the read-only telemetry relay (e.g. https://relay.stillloading.tech/api/telemetry)
# Leave blank to default to relative path /api/telemetry
VITE_TELEMETRY_API_URL=

# Default Telemetry Mode ('demo' or 'live')
VITE_DEFAULT_MODE=demo
