# Still Loading... Telemetry Relay Environment Configuration
# Copy this file to .env and set your private values
# NEVER COMMIT REAL BEARER TOKENS OR SECRETS TO SOURCE CONTROL

# Upstream UNO Q Receiver URL (Local development or local network IP)
UNO_Q_RECEIVER_URL=http://192.168.1.5:8090

# Shared secret bearer token (minimum 16 hex characters)
STILL_LOADING_TOKEN=paste_your_16_character_token_here

# Relay Port
PORT=8080
HOST=0.0.0.0

# Gemma runs on the Mac, not on the UNO Q. Leave GEMMA_ENABLED=0 to keep the
# rules explainer only. The default URL is a local Ollama OpenAI-compatible endpoint.
# GEMMA_API_KEY is optional and must not be committed.
GEMMA_ENABLED=0
GEMMA_BASE_URL=http://127.0.0.1:11434/v1
GEMMA_MODEL=gemma2:2b
GEMMA_API_KEY=
GEMMA_TIMEOUT_SECONDS=8
GEMMA_MAX_RETRIES=1
GEMMA_MAX_LOG_CHARS=6000
